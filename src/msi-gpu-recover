# Repository commands use the sibling helper; installed recovery uses the same
# fixed, root-owned libexec directory as the other controller commands.
_source_directory = pathlib.Path(__file__).resolve().parent
_helper_directory = (_source_directory if (_source_directory / "msi_fan_control.py").is_file()
                     else pathlib.Path("/usr/local/libexec"))
sys.path.insert(0, str(_helper_directory))
import msi_fan_control as fan_control

BASE = pathlib.Path("/sys/devices/platform/msi-ec")
LOCK = pathlib.Path("/run/msi-fanctl.lock")
RECOVERY_LATCH = pathlib.Path("/run/msi-fan-profile.recovery-boost")
RECOVERY_LATCH_PAYLOAD = b"candidate14\n"
FACTORY = (
    "58 64 70 76 82 88 0 25 35 44 58 70 75 "
    "52 58 64 70 76 82 0 25 35 44 58 70 75"
)
DEFAULT = (
    "50 60 70 76 82 88 20 30 40 50 60 80 110 "
    "38 40 42 44 55 70 20 30 40 60 70 100 120"
)
FULL_COOLING_CURVES = {"candidate14": DEFAULT}
STOP = False
FAN_RESPONSE_FLOOR_RPM = 3000
FAN_PLAUSIBILITY_LIMIT_RPM = 10000
FAN_RESPONSE_ALLOWANCE_SECONDS = 12.0
KEEPER_REPORT_INTERVAL_SECONDS = 60.0
POLL_INTERVAL_SECONDS = 1.0
MAX_OBSERVATION_GAP_SECONDS = 2.0


def read(path: pathlib.Path) -> str:
    with path.open("r", encoding="ascii") as stream:
        return stream.read().strip()


def read_uint(path: pathlib.Path) -> int:
    value = read(path)
    if not value.isascii() or not value.isdecimal():
        raise RuntimeError(f"nonnumeric sensor {path}: {value!r}")
    return int(value)


def write(path: pathlib.Path, value: str) -> None:
    if not identity_safe_for_curve_write():
        raise RuntimeError("immutable identity invalid before recovery write")
    with path.open("w", encoding="ascii") as stream:
        stream.write(value + "\n")
        stream.flush()
    if read(path) != value:
        raise RuntimeError(f"recovery readback mismatch for {path.name}")


def recovery_identity(*, monitoring: bool = False) -> dict[pathlib.Path, str]:
    values = fan_control.identity(read, BASE, monitoring=monitoring)
    if not (BASE / "fan_curve").exists():
        raise RuntimeError("required fan-curve ABI is absent")
    return values


def identity_safe_for_curve_write() -> bool:
    try:
        # Mutations never use monitoring's snapshot-based firmware shortcut.
        recovery_identity()
        return True
    except Exception:
        return False


def one_hwmon(name: str) -> pathlib.Path:
    matches = []
    for path in pathlib.Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if read(path / "name") == name:
                matches.append(path)
        except OSError:
            continue
    if len(matches) != 1:
        raise RuntimeError(f"expected one {name} hwmon; found {len(matches)}")
    return matches[0]


def notify(message: str) -> None:
    address = os.environ.get("NOTIFY_SOCKET")
    if not address:
        raise RuntimeError("NOTIFY_SOCKET is absent")
    if address.startswith("@"):
        address = "\0" + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
        sock.settimeout(0.5)
        sock.connect(address)
        sock.sendall(message.encode("utf-8"))


@dataclass(frozen=True)
class FanResponse:
    classification: str
    detail: str

    @property
    def verified(self) -> bool:
        return self.classification == "verified"

    @property
    def status(self) -> str:
        if self.verified:
            return f"fan response verified: {self.detail}"
        return f"fan response unverified: {self.classification}; {self.detail}"


def read_fan_response(wmi: pathlib.Path) -> FanResponse:
    """Sample response once; a response floor is not proof of maximum speed."""
    try:
        fan1 = read_uint(wmi / "fan1_input")
        fan2 = read_uint(wmi / "fan2_input")
    except OSError as error:
        return FanResponse("unavailable", f"fan telemetry unavailable: {error}")
    except Exception as error:
        return FanResponse("invalid", f"invalid fan telemetry: {error}")
    if not (0 <= fan1 <= FAN_PLAUSIBILITY_LIMIT_RPM and
            0 <= fan2 <= FAN_PLAUSIBILITY_LIMIT_RPM):
        return FanResponse("invalid", f"implausible fan telemetry: {fan1}/{fan2} RPM")
    detail = f"{fan1}/{fan2} RPM; response floor {FAN_RESPONSE_FLOOR_RPM} RPM"
    if fan1 >= FAN_RESPONSE_FLOOR_RPM and fan2 >= FAN_RESPONSE_FLOOR_RPM:
        return FanResponse("verified", detail)
    return FanResponse("low", detail)


def verify_boost(wmi: pathlib.Path,
                 heartbeat: Callable[[str], None] | None = None) -> bool:
    """Bounded one-shot verification of plausible fan response to Boost."""
    last = "fan response unverified: no telemetry sampled"
    for _ in range(12):
        # An external owner may switch Boost off between attempts. Reassert it
        # without ever bypassing the fresh identity guard in write().
        request_boost_best_effort()
        response = read_fan_response(wmi)
        last = response.status
        if heartbeat is not None:
            heartbeat(f"Recovery: {last}")
        if response.verified:
            return True
        time.sleep(1)
    request_boost_best_effort()
    print(f"recovery Cooler Boost {last}", file=sys.stderr)
    return False


@dataclass
class KeeperFanVerification:
    """Track response incrementally without interrupting control repair."""
    low_since: float | None = None
    unverified_since: float | None = None
    reported_classification: str | None = None
    last_report: float = float("-inf")

    def observe(self, response: FanResponse, now: float) -> tuple[str, bool]:
        classification = response.classification
        status = response.status
        if response.verified:
            self.low_since = None
            self.unverified_since = None
        else:
            if self.unverified_since is None:
                self.unverified_since = now
            status += f"; unverified for {now - self.unverified_since:.0f}s"
            if classification == "low":
                if self.low_since is None:
                    self.low_since = now
                low_elapsed = now - self.low_since
                if low_elapsed >= FAN_RESPONSE_ALLOWANCE_SECONDS:
                    classification = "low-sustained"
                    status += f"; below response floor for {low_elapsed:.0f}s"
                else:
                    status += f"; awaiting fan response for {low_elapsed:.0f}s"
            else:
                # Missing or invalid readings are not evidence of a stalled fan.
                self.low_since = None
        report = (classification != self.reported_classification or
                  (not response.verified and
                   now - self.last_report >= KEEPER_REPORT_INTERVAL_SECONDS))
        if report:
            self.reported_classification = classification
            self.last_report = now
        return status, report


@dataclass
class KeeperTimingMetrics:
    """Opt-in bounded diagnostics, independent of repair and response policy."""
    completed_loops: int = 0
    rpm_reads: int = 0
    deadline_misses: int = 0
    slow_rpm_reads: int = 0
    observation_gap_misses: int = 0
    last_loop_duration_ms: float | None = None
    max_loop_duration_ms: float = 0.0
    last_rpm_read_duration_ms: float | None = None
    max_rpm_read_duration_ms: float = 0.0
    last_observation_gap_seconds: float | None = None
    max_observation_gap_seconds: float = 0.0
    loop_started_ns: int | None = None
    rpm_started_ns: int | None = None
    previous_observation: float | None = None
    last_report: float | None = None

    def begin_loop(self) -> None:
        self.loop_started_ns = time.perf_counter_ns()

    def begin_rpm(self, observed_at: float) -> None:
        self.rpm_started_ns = time.perf_counter_ns()
        if self.previous_observation is not None:
            gap = max(0.0, observed_at - self.previous_observation)
            self.last_observation_gap_seconds = gap
            self.max_observation_gap_seconds = max(self.max_observation_gap_seconds, gap)
            self.observation_gap_misses += int(gap > MAX_OBSERVATION_GAP_SECONDS)
        self.previous_observation = observed_at

    def finish_rpm(self) -> None:
        assert self.rpm_started_ns is not None
        elapsed_ms = (time.perf_counter_ns() - self.rpm_started_ns) / 1_000_000
        self.last_rpm_read_duration_ms = elapsed_ms
        self.max_rpm_read_duration_ms = max(self.max_rpm_read_duration_ms, elapsed_ms)
        self.rpm_reads += 1
        self.slow_rpm_reads += int(elapsed_ms > MAX_OBSERVATION_GAP_SECONDS * 1000)

    def finish_loop(self) -> None:
        assert self.loop_started_ns is not None
        elapsed_ms = (time.perf_counter_ns() - self.loop_started_ns) / 1_000_000
        self.last_loop_duration_ms = elapsed_ms
        self.max_loop_duration_ms = max(self.max_loop_duration_ms, elapsed_ms)
        self.completed_loops += 1
        self.deadline_misses += int(elapsed_ms > POLL_INTERVAL_SECONDS * 1000)

    def report(self, now: float) -> None:
        if self.last_report is not None and now - self.last_report < KEEPER_REPORT_INTERVAL_SECONDS:
            return
        self.last_report = now
        payload = {
            "schema": 1,
            "pid": os.getpid(),
            "completed_loops": self.completed_loops,
            "rpm_reads": self.rpm_reads,
            "deadline_misses": self.deadline_misses,
            "slow_rpm_reads": self.slow_rpm_reads,
            "observation_gap_misses": self.observation_gap_misses,
            "last_loop_duration_ms": self.last_loop_duration_ms,
            "max_loop_duration_ms": self.max_loop_duration_ms,
            "last_rpm_read_duration_ms": self.last_rpm_read_duration_ms,
            "max_rpm_read_duration_ms": self.max_rpm_read_duration_ms,
            "last_observation_gap_seconds": self.last_observation_gap_seconds,
            "max_observation_gap_seconds": self.max_observation_gap_seconds,
        }
        print("TIMING keeper " + json.dumps(payload, sort_keys=True, allow_nan=False),
              file=sys.stderr, flush=True)


def configured_timing_metrics() -> KeeperTimingMetrics | None:
    value = os.environ.get("MSI_FAN_TIMING_METRICS", "0")
    if value == "1":
        return KeeperTimingMetrics()
    if value != "0":
        print(f"WARNING invalid MSI_FAN_TIMING_METRICS={value!r}; timing metrics disabled",
              file=sys.stderr, flush=True)
    return None


def request_boost_best_effort() -> None:
    """Request full fan speed without ever bypassing identity validation."""
    try:
        if read(BASE / "cooler_boost") != "on":
            write(BASE / "cooler_boost", "on")
    except Exception as error:
        print(f"recovery could not request Cooler Boost: {error}", file=sys.stderr)


def recovery_latch_present() -> bool:
    """Return whether a securely-created recovery Boost handoff is pending."""
    try:
        info = RECOVERY_LATCH.lstat()
    except FileNotFoundError:
        return False
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
            info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o600 or
            info.st_nlink != 1):
        raise RuntimeError("unsafe recovery Boost latch")
    descriptor = os.open(RECOVERY_LATCH, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        pinned = os.fstat(descriptor)
        if ((pinned.st_dev, pinned.st_ino) != (info.st_dev, info.st_ino) or
                not stat.S_ISREG(pinned.st_mode) or pinned.st_uid != 0 or
                pinned.st_gid != 0 or stat.S_IMODE(pinned.st_mode) != 0o600 or
                pinned.st_nlink != 1):
            raise RuntimeError("recovery Boost latch changed during validation")
        payload = os.read(descriptor, len(RECOVERY_LATCH_PAYLOAD) + 1)
    finally:
        os.close(descriptor)
    if payload != RECOVERY_LATCH_PAYLOAD:
        raise RuntimeError("invalid recovery Boost latch payload")
    return True


def mark_recovery_latch(profile: str) -> None:
    """Atomically record that a recovery-owned Boost must become automatic."""
    payload = f"{profile}\n".encode("ascii")
    if payload != RECOVERY_LATCH_PAYLOAD:
        raise RuntimeError(f"unexpected recovery latch profile {profile!r}")
    try:
        descriptor = os.open(
            RECOVERY_LATCH,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
        )
    except FileExistsError:
        if recovery_latch_present():
            return
        raise
    try:
        os.fchown(descriptor, 0, 0)
        os.fchmod(descriptor, 0o600)
        if os.write(descriptor, payload) != len(payload):
            raise RuntimeError("short recovery Boost latch write")
        os.fsync(descriptor)
    except Exception:
        try:
            RECOVERY_LATCH.unlink()
        except OSError:
            pass
        raise
    finally:
        os.close(descriptor)
    if not recovery_latch_present():
        raise RuntimeError("recovery Boost latch verification failed")


def release_boost_if_cool() -> bool:
    """Complete an intentional clean-stop factory transition only when cool."""
    try:
        core = one_hwmon("coretemp")
        package = read_uint(core / "temp1_input")
        ec_cpu = read_uint(BASE / "cpu/realtime_temperature")
        gpu = read_uint(BASE / "gpu/realtime_temperature")
        if not (0 <= package <= 110000 and 0 <= ec_cpu <= 110 and
                0 <= gpu <= 110):
            return False
        if not (max(package, ec_cpu * 1000) < 85000 and
                (gpu == 0 or gpu < 70)):
            return False
        write(BASE / "fan_mode", "auto")
        if read(BASE / "fan_mode") != "auto":
            return False
        write(BASE / "cooler_boost", "off")
        if (read(BASE / "fan_mode") == "auto" and
                read(BASE / "fan_curve") == FACTORY and
                read(BASE / "cooler_boost") == "off"):
            return True
        write(BASE / "cooler_boost", "on")
        return False
    except Exception as error:
        print(f"Boost release failed: {error}", file=sys.stderr)
        request_boost_best_effort()
        return False


def stage_full_cooling(profile: str) -> None:
    """Establish Candidate14/advanced/Boost-on without depending on WMI RPM."""
    curve = FULL_COOLING_CURVES.get(profile)
    if curve is None:
        raise RuntimeError(f"no exact full-cooling curve for profile {profile!r}")
    if not identity_safe_for_curve_write():
        raise RuntimeError("exact recovery identity/ABI check failed")
    # Assert maximum cooling before WMI discovery. An unavailable RPM channel
    # can limit physical verification, but must never delay the Boost request.
    write(BASE / "cooler_boost", "on")
    mode = read(BASE / "fan_mode")
    current = read(BASE / "fan_curve")
    if current == curve and mode == "advanced":
        if read(BASE / "cooler_boost") != "on":
            raise RuntimeError("full-cooling Boost readback failed")
        return
    # This is the same safe transactional ordering used by the daemon.
    write(BASE / "fan_mode", "auto")
    write(BASE / "fan_curve", curve)
    if (read(BASE / "fan_mode") != "auto" or
            read(BASE / "fan_curve") != curve or
            read(BASE / "cooler_boost") != "on"):
        raise RuntimeError("full-cooling curve transaction verification failed")
    write(BASE / "fan_mode", "advanced")
    if (read(BASE / "fan_mode") != "advanced" or
            read(BASE / "fan_curve") != curve or
            read(BASE / "cooler_boost") != "on"):
        raise RuntimeError("full-cooling final readback failed")


def attempt_full_cooling(profile: str) -> bool:
    """Establish Candidate14/advanced/Boost-on after a non-clean service exit."""
    try:
        stage_full_cooling(profile)
        mark_recovery_latch(profile)
        wmi = one_hwmon("msi_wmi_platform")
        if verify_boost(wmi):
            return True
        print("full-cooling RPM verification failed; retaining Boost request",
              file=sys.stderr)
    except Exception as error:
        print(f"full-cooling recovery failed: {error}", file=sys.stderr)
    # Even if WMI cannot prove RPM, never overwrite the selected curve with the
    # factory curve on a runtime fault. Re-request Boost when that is safe.
    request_boost_best_effort()
    return False


def acquire_lock(timeout_seconds: float = 12.0) -> int:
    info = LOCK.stat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
            stat.S_IMODE(info.st_mode) != 0o600):
        raise RuntimeError("unsafe fan-control lock")
    descriptor = os.open(LOCK, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    deadline = time.monotonic() + timeout_seconds
    try:
        while True:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return descriptor
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError("fan-control lock remained busy")
                time.sleep(0.05)
    except Exception:
        os.close(descriptor)
        raise


def keeper_heartbeat(status: str) -> None:
    notify(f"WATCHDOG=1\nSTATUS={status}")


def keeper_repair(profile: str) -> str:
    """Reassert a drifted recovery state without needlessly rewriting its curve."""
    curve = FULL_COOLING_CURVES[profile]
    try:
        identity = recovery_identity(monitoring=True)
        if identity[fan_control.SOURCE_PATH] == fan_control.SNAPSHOT_SRCVERSION:
            # The pinned new ABI provides a fresh firmware/control snapshot in
            # one transaction; malformed or absent snapshots never fall back.
            control = fan_control.snapshot(read, BASE)
            current_curve, mode, boost = control.curve, control.mode, control.boost
        else:
            current_curve = read(BASE / "fan_curve")
            mode = read(BASE / "fan_mode")
            boost = read(BASE / "cooler_boost")
    except Exception as error:
        raise RuntimeError(f"exact recovery identity/ABI check failed: {error}") from error
    if current_curve != curve or mode != "advanced":
        stage_full_cooling(profile)
        return "Candidate14/advanced restaged with Cooler Boost on"
    if boost != "on":
        write(BASE / "cooler_boost", "on")
        return "Cooler Boost reasserted"
    return "Candidate14/advanced with Cooler Boost on"


def run_keeper(profile: str) -> int:
    """Keep full cooling asserted after a failed daemon until an operator restarts it."""
    global STOP
    timing = configured_timing_metrics()
    try:
        stage_full_cooling(profile)
        mark_recovery_latch(profile)
    except Exception as error:
        print(f"FATAL: recovery keeper could not establish full cooling: {error}",
              file=sys.stderr)
        request_boost_best_effort()
        return 1
    initial_status = ("Candidate14 recovery keeper active; Cooler Boost on; "
                      "fan response unverified: awaiting telemetry")
    keeper_heartbeat(initial_status)
    notify(f"READY=1\nWATCHDOG=1\nSTATUS={initial_status}")
    print("recovery keeper active; Candidate14/advanced and Cooler Boost will remain asserted",
          file=sys.stderr)
    verification = KeeperFanVerification()
    wmi: pathlib.Path | None = None
    suspend_offset = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
    while not STOP:
        started = time.monotonic()
        if timing is not None:
            timing.begin_loop()
        current_offset = time.clock_gettime(time.CLOCK_BOOTTIME) - started
        if current_offset - suspend_offset > 2:
            wmi = None
        suspend_offset = current_offset
        try:
            state = keeper_repair(profile)
        except Exception as error:
            print(f"FATAL: recovery keeper control repair failed: {error}",
                  file=sys.stderr)
            request_boost_best_effort()
            return 1
        if timing is not None:
            timing.begin_rpm(time.monotonic())
        try:
            if wmi is None:
                # Pin the discovered symlink target instead of rediscovering
                # every hwmon device each second. Resume/read failure invalidates it.
                wmi = one_hwmon("msi_wmi_platform").resolve()
        except Exception as error:
            response = FanResponse("unavailable", f"fan telemetry unavailable: {error}")
        else:
            response = read_fan_response(wmi)
            if response.classification == "unavailable":
                wmi = None
        if timing is not None:
            timing.finish_rpm()
        # Exactly one RPM sample follows each completed control repair. Failed
        # telemetry never creates a multi-second verification sleep, and each
        # heartbeat describes both completed repair and current fan response.
        response_status, report = verification.observe(response, time.monotonic())
        keeper_heartbeat(f"{state}; {response_status}")
        if report:
            print(f"recovery keeper retains Cooler Boost; {response_status}",
                  file=sys.stderr)
        if timing is not None:
            timing.finish_loop()
            timing.report(time.monotonic())
        delay = POLL_INTERVAL_SECONDS - (time.monotonic() - started)
        if delay > 0:
            time.sleep(delay)
    print("recovery keeper stopped by operator; leaving full-cooling state intact",
          file=sys.stderr)
    notify("STOPPING=1\nSTATUS=Recovery keeper stopped; full cooling retained")
    return 0


def on_stop(_number: int, _frame: object) -> None:
    global STOP
    STOP = True


def main() -> int:
    global STOP
    if os.geteuid() != 0:
        print("root required", file=sys.stderr)
        return 1
    keeper_mode = len(sys.argv) == 3 and sys.argv[1] == "--keeper"
    if keeper_mode:
        profile = sys.argv[2]
    elif len(sys.argv) == 2:
        profile = sys.argv[1]
    else:
        print("FATAL: recovery requires candidate14 or --keeper candidate14",
              file=sys.stderr)
        return 1
    if profile != "candidate14":
        print("FATAL: recovery requires the exact candidate14 profile argument",
              file=sys.stderr)
        return 1
    if os.environ.get("MSI_CALIBRATION_PROFILE") != profile:
        print("FATAL: recovery profile argument/environment mismatch", file=sys.stderr)
        return 1
    if keeper_mode:
        signal.signal(signal.SIGTERM, on_stop)
        signal.signal(signal.SIGINT, on_stop)
        signal.signal(signal.SIGHUP, on_stop)
        STOP = False
        print(f"recovery keeper invoked profile={profile}", file=sys.stderr)
    else:
        service_result = os.environ.get("SERVICE_RESULT", "unknown")
        exit_code = os.environ.get("EXIT_CODE", "unknown")
        exit_status = os.environ.get("EXIT_STATUS", "unknown")
        print(
            f"recovery invoked profile={profile} service_result={service_result} "
            f"exit_code={exit_code} exit_status={exit_status}",
            file=sys.stderr,
        )
    try:
        descriptor = acquire_lock()
    except Exception as error:
        print("FATAL: recovery lock unavailable; no unlocked write attempted: "
              f"{error}", file=sys.stderr)
        return 1
    try:
        # No model-specific control operation is permitted before exact ABI and
        # immutable hardware identity validation.
        if not identity_safe_for_curve_write():
            print("FATAL: exact recovery identity/ABI check failed; no curve write "
                  "attempted", file=sys.stderr)
            return 1
        if keeper_mode:
            return run_keeper(profile)

        success_result = (service_result == "success" and
                          exit_code == "exited" and exit_status == "0")
        if success_result:
            try:
                if (read(BASE / "fan_mode") == "auto" and
                        read(BASE / "fan_curve") == FACTORY and
                        read(BASE / "cooler_boost") == "off"):
                    if release_boost_if_cool():
                        print(f"successful {profile} service left thermally verified "
                              "factory auto/off", file=sys.stderr)
                        return 0
                    request_boost_best_effort()
                    print("successful service ended factory auto/off while too hot; "
                          "Boost re-enabled", file=sys.stderr)
                    return 1
            except Exception as error:
                print(f"success-state verification failed: {error}", file=sys.stderr)

        # A failure, timeout, watchdog, signal, or unexpected clean-stop state
        # keeps the selected exact curve and maximum cooling instead of factory auto.
        if attempt_full_cooling(profile):
            print("runtime recovery verified Candidate14/advanced with Cooler Boost on",
                  file=sys.stderr)
            return 1 if success_result else 0
        print("FATAL: full-cooling fan response could not be verified; "
              "Cooler Boost was requested without a factory fallback", file=sys.stderr)
        return 1
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    raise SystemExit(main())

# Source checkouts keep the shared ABI helper beside this script; installed
# programs use the fixed root-owned libexec directory, never the working directory.
_ABI_DIR = pathlib.Path(__file__).resolve().parent
if not (_ABI_DIR / "msi_fan_control.py").is_file():
    _ABI_DIR = pathlib.Path("/usr/local/libexec")
sys.path.insert(0, str(_ABI_DIR))
import msi_fan_control as fan_control

BASE = pathlib.Path("/sys/devices/platform/msi-ec")
LOCK = pathlib.Path("/run/msi-fanctl.lock")
OVERRIDE = pathlib.Path("/run/msi-fan-profile.factory-auto")
ACK = pathlib.Path("/run/msi-fan-profile.ack")
HEALTH = pathlib.Path("/run/msi-fan-profile.health.json")
RECOVERY_LATCH = pathlib.Path("/run/msi-fan-profile.recovery-boost")
RECOVERY_LATCH_PAYLOAD = b"candidate14\n"
FACTORY = (
    "58 64 70 76 82 88 0 25 35 44 58 70 75 "
    "52 58 64 70 76 82 0 25 35 44 58 70 75"
)
DEFAULT = (
    "50 60 70 76 82 88 20 30 40 50 60 80 110 "
    "38 40 42 44 55 70 20 30 40 60 70 100 120"
)
STOP = False
BOOST_REQUEST = False
RELEASE_REQUEST = False
SUSTAINED_ALARM_SECONDS = 15.0
SUSTAINED_ALARM_REPORT_SECONDS = 60.0
SENSOR_DEGRADED_REPORT_SECONDS = 60.0
BOOST_RESPONSE_SECONDS = 12.0
BOOST_LOW_EVIDENCE_SECONDS = 2.0
BOOST_RESPONSE_RPM = 3000
MAX_OBSERVATION_GAP_SECONDS = 2.0
POLL_INTERVAL_SECONDS = 1.0


class ProfileError(RuntimeError):
    pass


class SensorSampleError(ProfileError):
    """A malformed or implausible sampled telemetry value.

    This is deliberately narrower than ProfileError: a short sequence can be
    deglitched while keeping maximum cooling asserted, whereas control,
    identity, and write failures must still fail immediately.
    """

    def __init__(self, message: str, partial: RuntimeSample | None = None,
                 channel_errors: dict[str, str] | None = None):
        super().__init__(message)
        self.partial = partial
        self.channel_errors = channel_errors or {}


def read(path: pathlib.Path) -> str:
    with path.open("r", encoding="ascii") as stream:
        return stream.read().strip()


def read_uint(path: pathlib.Path) -> int:
    value = read(path)
    if not value.isascii() or not value.isdecimal():
        raise SensorSampleError(f"nonnumeric sensor {path}: {value!r}")
    return int(value)


def write(path: pathlib.Path, value: str) -> None:
    # Every control mutation is preceded by a fresh immutable ABI/platform check.
    if not immutable_identity_valid():
        raise ProfileError("immutable identity invalid before control write")
    with path.open("w", encoding="ascii") as stream:
        stream.write(value + "\n")
        stream.flush()
    if read(path) != value:
        raise ProfileError(f"readback mismatch for {path.name}")


def one_hwmon(name: str) -> pathlib.Path:
    matches = []
    for path in pathlib.Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if read(path / "name") == name:
                matches.append(path)
        except OSError:
            continue
    if len(matches) != 1:
        raise ProfileError(f"expected one {name} hwmon; found {len(matches)}")
    return matches[0]


def notify(message: str) -> None:
    address = os.environ.get("NOTIFY_SOCKET")
    if not address:
        raise ProfileError("NOTIFY_SOCKET is absent")
    if address.startswith("@"):
        address = "\0" + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
        sock.settimeout(0.5)
        sock.connect(address)
        sock.sendall(message.encode("utf-8"))


def immutable_identity_valid() -> bool:
    try:
        fan_control.identity(read, BASE)
        return True
    except (OSError, fan_control.ControlABIError):
        return False


def require_immutable_identity() -> None:
    if not immutable_identity_valid():
        raise ProfileError("immutable hardware/driver/EC identity validation failed")


@dataclass(frozen=True)
class MonitorControl:
    state: fan_control.ControlSnapshot
    acquisition_started: float


def require_policy_identity(*, monitoring: bool = False,
                            timing: TimingMetrics | None = None) -> MonitorControl | None:
    if not monitoring:
        require_immutable_identity()
        shift = read(BASE / "shift_mode")
        control = None
    else:
        try:
            identity = fan_control.identity(read, BASE, monitoring=True)
            if identity[fan_control.SOURCE_PATH] == fan_control.SNAPSHOT_SRCVERSION:
                acquisition_started = time.monotonic()
                if timing is not None:
                    timing.begin_sensor(acquisition_started)
                state = fan_control.snapshot(read, BASE)
                control = MonitorControl(state, acquisition_started)
                shift = state.shift
            else:
                control = None
                shift = read(BASE / "shift_mode")
        except (OSError, fan_control.ControlABIError) as error:
            raise ProfileError(f"monitoring identity/ABI validation failed: {error}") from error
    if shift != "comfort":
        raise ProfileError("EC shift mode is no longer comfort")
    return control


def verify_boost(wmi: pathlib.Path, heartbeat: Callable[[str], None]) -> None:
    last_sensor_error: SensorSampleError | None = None
    consecutive_low_samples = 0
    for _ in range(12):
        # Startup verification must also keep the commanded state asserted.
        write(BASE / "cooler_boost", "on")
        try:
            fan1 = read_uint(wmi / "fan1_input")
            fan2 = read_uint(wmi / "fan2_input")
            if not (0 <= fan1 <= 10000 and 0 <= fan2 <= 10000):
                raise SensorSampleError(
                    f"implausible physical fan telemetry: fan1={fan1}RPM "
                    f"fan2={fan2}RPM")
        except (SensorSampleError, OSError) as error:
            # A WMI sentinel or malformed read must not be mistaken for RPM,
            # but a single transient must not defeat a commanded Boost state.
            last_sensor_error = SensorSampleError(str(error))
            consecutive_low_samples = 0
            heartbeat(f"Verifying Cooler Boost: invalid fan telemetry: {error}")
            time.sleep(1)
            continue
        consecutive_low_samples += 1
        heartbeat(f"Verifying Cooler Boost: fans {fan1}/{fan2} RPM")
        if BOOST_RESPONSE_RPM <= fan1 <= 10000 and BOOST_RESPONSE_RPM <= fan2 <= 10000:
            return
        time.sleep(1)
    if consecutive_low_samples < 3:
        raise SensorSampleError(
            "physical Cooler Boost verification deferred: insufficient recent "
            f"continuous valid RPM evidence; {last_sensor_error}")
    detail = f"; last sensor error: {last_sensor_error}" if last_sensor_error else ""
    raise ProfileError("both physical fans did not verify under Cooler Boost" + detail)


def force_apply_default(wmi: pathlib.Path, preserve_boost: bool,
                        heartbeat: Callable[[str], None]) -> bool:
    """Reprogram Candidate14 under auto+Boost, then enter advanced mode."""
    require_policy_identity()
    curve = read(BASE / "fan_curve")
    mode = read(BASE / "fan_mode")
    boost = read(BASE / "cooler_boost")
    recognized = ((curve == FACTORY and mode == "auto") or
                  (curve == DEFAULT and mode == "advanced"))
    if not recognized or boost not in ("on", "off"):
        raise ProfileError(f"unrecognized pre-apply state: {mode}/{boost}/{curve!r}")
    # Normalize before every apply, including resume. The transactional driver
    # itself establishes and verifies auto+Boost around the curve write.
    write(BASE / "cooler_boost", "on")
    write(BASE / "fan_mode", "auto")
    write(BASE / "fan_curve", DEFAULT)
    if read(BASE / "fan_mode") != "auto" or read(BASE / "cooler_boost") != "on":
        raise ProfileError("curve transaction did not retain auto/Boost envelope")
    physically_verified = True
    try:
        verify_boost(wmi, heartbeat)
    except SensorSampleError as error:
        # The EC control write and its readbacks succeeded, but a WMI sentinel
        # means physical RPM cannot be certified yet. Keep Boost latched and
        # let the persistent degraded-telemetry state verify it later.
        physically_verified = False
        print(
            "WARNING Candidate14 staged with Cooler Boost requested; "
            f"physical fan telemetry is invalid: {error}",
            file=sys.stderr, flush=True)
    require_policy_identity()
    write(BASE / "fan_mode", "advanced")
    if read(BASE / "cooler_boost") != "on":
        raise ProfileError("Boost changed before advanced verification")
    keep_boost = preserve_boost or not physically_verified
    if not keep_boost:
        write(BASE / "cooler_boost", "off")
    if (read(BASE / "fan_curve") != DEFAULT or
            read(BASE / "fan_mode") != "advanced" or
            read(BASE / "cooler_boost") != ("on" if keep_boost else "off")):
        raise ProfileError("default profile final readback failed")
    return physically_verified


def restore_factory_envelope() -> bool:
    """Best-effort full factory restore, deliberately ending at auto+Boost-on."""
    if not immutable_identity_valid():
        print("FATAL: immutable identity invalid; no recovery write attempted",
              file=sys.stderr, flush=True)
        return False
    success = True
    for path, value in (
        (BASE / "cooler_boost", "on"),
        (BASE / "fan_mode", "auto"),
        (BASE / "fan_curve", FACTORY),
        (BASE / "cooler_boost", "on"),
    ):
        try:
            write(path, value)
        except Exception as error:
            success = False
            print(f"restore write failed {path}: {error}", file=sys.stderr,
                  flush=True)
    try:
        success &= read(BASE / "fan_mode") == "auto"
        success &= read(BASE / "fan_curve") == FACTORY
        success &= read(BASE / "cooler_boost") == "on"
    except Exception as error:
        success = False
        print(f"restore verification failed: {error}", file=sys.stderr,
              flush=True)
    return bool(success)


def cool_now(core: pathlib.Path) -> bool:
    package = read_uint(core / "temp1_input")
    ec_cpu = read_uint(BASE / "cpu/realtime_temperature")
    ec_gpu = read_uint(BASE / "gpu/realtime_temperature")
    return max(package, ec_cpu * 1000) < 85000 and (ec_gpu == 0 or ec_gpu < 70)


def release_factory_if_cool(core: pathlib.Path) -> bool:
    try:
        if not cool_now(core):
            return False
        write(BASE / "fan_mode", "auto")
        write(BASE / "cooler_boost", "off")
        if read(BASE / "fan_mode") == "auto" and read(BASE / "cooler_boost") == "off":
            return True
        write(BASE / "cooler_boost", "on")
    except Exception:
        try:
            write(BASE / "cooler_boost", "on")
        except Exception:
            pass
    return False


@dataclass(frozen=True)
class RuntimeSample:
    package: int | None
    ec_cpu: int | None
    ec_gpu: int | None
    fan1: int | None
    fan2: int | None

    @property
    def cpu(self) -> int:
        if self.package is None or self.ec_cpu is None:
            raise SensorSampleError("CPU temperature is unavailable")
        return max(self.package, self.ec_cpu * 1000)

    def as_health(self) -> dict[str, int | None]:
        return dict(zip(
            ("package_millidegrees", "ec_cpu_celsius", "ec_gpu_celsius",
             "fan1_rpm", "fan2_rpm"),
            (self.package, self.ec_cpu, self.ec_gpu, self.fan1, self.fan2)))


def read_runtime_sample(core: pathlib.Path, wmi: pathlib.Path, *,
                        ec_temperatures: tuple[int, int] | None = None) -> RuntimeSample:
    """Read every channel, retaining healthy values when another one fails."""
    values: dict[str, int | None] = {}
    errors: dict[str, str] = {}
    for name, path, ceiling, unit in (
        ("package", core / "temp1_input", 110000, "mC"),
        ("ec_cpu", BASE / "cpu/realtime_temperature", 110, "C"),
        ("ec_gpu", BASE / "gpu/realtime_temperature", 110, "C"),
        ("fan1", wmi / "fan1_input", 10000, "RPM"),
        ("fan2", wmi / "fan2_input", 10000, "RPM"),
    ):
        try:
            if ec_temperatures is not None and name in ("ec_cpu", "ec_gpu"):
                value = ec_temperatures[0 if name == "ec_cpu" else 1]
            else:
                value = read_uint(path)
            if name == "ec_cpu" and value == 255:
                # The exact meaning of the raw firmware byte is unconfirmed;
                # 255C is certainly unavailable/implausible temperature data.
                raise SensorSampleError("EC CPU temperature sentinel 255C")
            if not 0 <= value <= ceiling:
                raise SensorSampleError(f"implausible {name}={value}{unit}")
            values[name] = value
        except (SensorSampleError, OSError) as error:
            values[name] = None
            errors[name] = str(error)
    sample = RuntimeSample(**values)
    if errors:
        raise SensorSampleError("; ".join(errors.values()), sample, errors)
    return sample


@dataclass
class BoostResponse:
    """Incremental per-fan response evidence, independent of temperatures."""
    started: float
    fan1_low_since: float | None = None
    fan2_low_since: float | None = None
    fan1_low_samples: int = 0
    fan2_low_samples: int = 0
    last_observed: float | None = None

    def observe(self, fan1: int | None, fan2: int | None, now: float) -> bool:
        if self.last_observed is not None and now - self.last_observed > 2:
            self.fan1_low_since = self.fan2_low_since = None
            self.fan1_low_samples = self.fan2_low_samples = 0
        self.last_observed = now
        for name, rpm in (("fan1", fan1), ("fan2", fan2)):
            attribute = f"{name}_low_since"
            count_attribute = f"{name}_low_samples"
            low = rpm is not None and 0 <= rpm < BOOST_RESPONSE_RPM
            since = Safety.update_since(getattr(self, attribute), low, now)
            setattr(self, attribute, since)
            count = getattr(self, count_attribute) + 1 if low else 0
            setattr(self, count_attribute, count)
            if (now - self.started >= BOOST_RESPONSE_SECONDS and since is not None
                    and count >= 3 and now - since >= BOOST_LOW_EVIDENCE_SECONDS):
                raise ProfileError(f"{name} did not respond under Cooler Boost: {rpm} RPM")
        return (fan1 is not None and fan2 is not None and
                BOOST_RESPONSE_RPM <= fan1 <= 10000 and
                BOOST_RESPONSE_RPM <= fan2 <= 10000)


@dataclass
class TimingMetrics:
    """Opt-in bounded diagnostic counters; never determine cooling policy."""
    completed_loops: int = 0
    sensor_reads: int = 0
    deadline_misses: int = 0
    slow_sensor_reads: int = 0
    last_loop_duration_ms: float | None = None
    max_loop_duration_ms: float = 0.0
    last_sensor_read_duration_ms: float | None = None
    max_sensor_read_duration_ms: float = 0.0
    last_observation_gap_seconds: float | None = None
    max_observation_gap_seconds: float = 0.0
    loop_started_ns: int | None = None
    sensor_started_ns: int | None = None
    previous_observation: float | None = None

    def begin_loop(self) -> None:
        self.loop_started_ns = time.perf_counter_ns()

    def begin_sensor(self, observed_at: float) -> None:
        self.sensor_started_ns = time.perf_counter_ns()
        if self.previous_observation is not None:
            gap = max(0.0, observed_at - self.previous_observation)
            self.last_observation_gap_seconds = gap
            self.max_observation_gap_seconds = max(self.max_observation_gap_seconds, gap)
        self.previous_observation = observed_at

    def finish_sensor(self, slow: bool) -> None:
        assert self.sensor_started_ns is not None
        elapsed_ms = (time.perf_counter_ns() - self.sensor_started_ns) / 1_000_000
        self.last_sensor_read_duration_ms = elapsed_ms
        self.max_sensor_read_duration_ms = max(self.max_sensor_read_duration_ms, elapsed_ms)
        self.sensor_reads += 1
        self.slow_sensor_reads += int(slow)

    def finish_loop(self) -> None:
        assert self.loop_started_ns is not None
        elapsed_ms = (time.perf_counter_ns() - self.loop_started_ns) / 1_000_000
        self.last_loop_duration_ms = elapsed_ms
        self.max_loop_duration_ms = max(self.max_loop_duration_ms, elapsed_ms)
        self.completed_loops += 1
        self.deadline_misses += int(elapsed_ms > POLL_INTERVAL_SECONDS * 1000)

    def snapshot(self) -> dict[str, int | float | None]:
        # Loop work includes health publication/notify and excludes cadence sleep.
        # A snapshot carries the last completed loop, plus this cycle's sensor read.
        return {
            "schema": 1,
            "completed_loops": self.completed_loops,
            "sensor_reads": self.sensor_reads,
            "deadline_misses": self.deadline_misses,
            "slow_sensor_reads": self.slow_sensor_reads,
            "last_loop_duration_ms": self.last_loop_duration_ms,
            "max_loop_duration_ms": self.max_loop_duration_ms,
            "last_sensor_read_duration_ms": self.last_sensor_read_duration_ms,
            "max_sensor_read_duration_ms": self.max_sensor_read_duration_ms,
            "last_observation_gap_seconds": self.last_observation_gap_seconds,
            "max_observation_gap_seconds": self.max_observation_gap_seconds,
        }


def configured_timing_metrics() -> TimingMetrics | None:
    value = os.environ.get("MSI_FAN_TIMING_METRICS", "0")
    if value == "1":
        return TimingMetrics()
    if value != "0":
        print(f"WARNING invalid MSI_FAN_TIMING_METRICS={value!r}; timing metrics disabled",
              file=sys.stderr, flush=True)
    return None


def publish_health(payload: dict[str, object]) -> None:
    """Atomically publish an unprivileged-readable, root-owned runtime snapshot."""
    try:
        info = HEALTH.lstat()
    except FileNotFoundError:
        pass
    else:
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
                or stat.S_IMODE(info.st_mode) != 0o644 or info.st_nlink != 1):
            raise ProfileError("unsafe runtime health file")
    descriptor, temporary = tempfile.mkstemp(
        prefix=".msi-fan-profile.health.", dir=HEALTH.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="ascii") as stream:
            os.fchown(stream.fileno(), 0, 0)
            os.fchmod(stream.fileno(), 0o644)
            json.dump(payload, stream, sort_keys=True, allow_nan=False)
            stream.write("\n")
            stream.flush()
        os.replace(temporary, HEALTH)
    finally:
        pathlib.Path(temporary).unlink(missing_ok=True)


@dataclass
class Safety:
    cpu_100: float | None = None
    cpu_98: float | None = None
    gpu_82: float | None = None
    gpu_80: float | None = None
    fan1_stall: float | None = None
    fan2_stall: float | None = None
    cool_since: float | None = None

    @staticmethod
    def update_since(previous: float | None, condition: bool,
                     now: float) -> float | None:
        return (now if previous is None else previous) if condition else None

    def update(self, cpu: int, gpu: int, fan1: int, fan2: int,
               now: float) -> str | None:
        if cpu >= 103000:
            return f"CPU immediate limit {cpu} mC"
        if gpu >= 85:
            return f"GPU immediate limit {gpu} C"
        self.cpu_100 = self.update_since(self.cpu_100, cpu >= 100000, now)
        self.cpu_98 = self.update_since(self.cpu_98, cpu >= 98000, now)
        self.gpu_82 = self.update_since(self.gpu_82, gpu >= 82, now)
        self.gpu_80 = self.update_since(self.gpu_80, gpu >= 80, now)
        self.fan1_stall = self.update_since(
            self.fan1_stall, cpu >= 80000 and fan1 < 1000, now)
        self.fan2_stall = self.update_since(
            self.fan2_stall, gpu >= 70 and fan2 < 1000, now)
        for since, limit, message in (
            (self.cpu_100, 2, "CPU >=100 C for 2 seconds"),
            (self.cpu_98, 9, "CPU >=98 C for 9 seconds"),
            (self.gpu_82, 2, "GPU >=82 C for 2 seconds"),
            (self.gpu_80, 9, "GPU >=80 C for 9 seconds"),
            (self.fan1_stall, 4, "fan 1 stalled for 4 seconds"),
            (self.fan2_stall, 4, "fan 2 stalled for 4 seconds"),
        ):
            if since is not None and now - since >= limit:
                return message
        return None


@dataclass
class AlarmHold:
    """Track a verified thermal alarm without turning maximum cooling into a fault."""
    verified_since: float | None = None
    sustained: bool = False
    last_report: float | None = None

    def record_verification(self, now: float) -> str | None:
        """Return the state transition caused by a successful Boost verification."""
        if self.verified_since is None:
            self.verified_since = now
            return "established"
        if (not self.sustained and
                now - self.verified_since >= SUSTAINED_ALARM_SECONDS):
            self.sustained = True
            self.last_report = now
            return "sustained"
        if (self.sustained and self.last_report is not None and
                now - self.last_report >= SUSTAINED_ALARM_REPORT_SECONDS):
            self.last_report = now
            return "ongoing"
        return None

    def clear(self) -> bool:
        """Reset on a safe sample and report whether a sustained alarm cleared."""
        was_sustained = self.sustained
        self.verified_since = None
        self.sustained = False
        self.last_report = None
        return was_sustained


@dataclass
class SensorHold:
    """Non-expiring invalid-telemetry latch while maximum cooling stays active."""
    started: float | None = None
    last_report: float | None = None

    def record(self, now: float) -> str | None:
        if self.started is None:
            self.started = now
            self.last_report = now
            return "established"
        if (self.last_report is None or
                now - self.last_report >= SENSOR_DEGRADED_REPORT_SECONDS):
            self.last_report = now
            return "ongoing"
        return None

    def elapsed(self, now: float) -> float:
        return 0.0 if self.started is None else now - self.started

    def clear(self) -> bool:
        if self.started is None:
            return False
        self.started = None
        self.last_report = None
        return True


def acknowledge(action: str) -> None:
    temporary = pathlib.Path(f"/run/.msi-fan-profile.ack.{os.getpid()}")
    payload = f"pid={os.getpid()} action={action} monotonic_ns={time.monotonic_ns()}\n"
    descriptor = os.open(temporary,
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL |
                         os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    os.fchown(descriptor, 0, 0)
    os.write(descriptor, payload.encode("ascii"))
    os.fsync(descriptor)
    os.close(descriptor)
    os.replace(temporary, ACK)


def recovery_latch_present() -> bool:
    """Validate a one-shot, root-owned full-cooling handoff marker."""
    try:
        info = RECOVERY_LATCH.lstat()
    except FileNotFoundError:
        return False
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
            info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o600 or
            info.st_nlink != 1):
        raise ProfileError("unsafe recovery Boost latch")
    descriptor = os.open(RECOVERY_LATCH, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        pinned = os.fstat(descriptor)
        if ((pinned.st_dev, pinned.st_ino) != (info.st_dev, info.st_ino) or
                not stat.S_ISREG(pinned.st_mode) or pinned.st_uid != 0 or
                pinned.st_gid != 0 or stat.S_IMODE(pinned.st_mode) != 0o600 or
                pinned.st_nlink != 1):
            raise ProfileError("recovery Boost latch changed during validation")
        payload = os.read(descriptor, len(RECOVERY_LATCH_PAYLOAD) + 1)
    finally:
        os.close(descriptor)
    if payload != RECOVERY_LATCH_PAYLOAD:
        raise ProfileError("invalid recovery Boost latch payload")
    return True


def consume_recovery_latch() -> bool:
    """Remove a validated handoff only after Candidate14 has been re-applied."""
    if not recovery_latch_present():
        return False
    RECOVERY_LATCH.unlink()
    if recovery_latch_present():
        raise ProfileError("recovery Boost latch remained after consumption")
    return True


def on_stop(_number: int, _frame: object) -> None:
    global STOP
    STOP = True


def on_boost(_number: int, _frame: object) -> None:
    global BOOST_REQUEST, RELEASE_REQUEST
    BOOST_REQUEST = True
    # A newer manual-on intent supersedes an older unprocessed release.
    RELEASE_REQUEST = False


def on_release(_number: int, _frame: object) -> None:
    global RELEASE_REQUEST
    RELEASE_REQUEST = True


def main() -> int:
    global BOOST_REQUEST, RELEASE_REQUEST
    if os.geteuid() != 0:
        raise ProfileError("root required")
    if read(pathlib.Path("/proc/self/cgroup")) != "0::/system.slice/msi-fan-profile.service":
        raise ProfileError("unexpected service cgroup")
    timing = configured_timing_metrics()
    info = LOCK.stat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
            stat.S_IMODE(info.st_mode) != 0o600):
        raise ProfileError("unsafe fan-control lock")
    descriptor = os.open(LOCK, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        os.close(descriptor)
        raise ProfileError("fan-control lock is busy") from error

    try:
        OVERRIDE.lstat()
    except FileNotFoundError:
        pass
    else:
        os.close(descriptor)
        raise ProfileError("factory-auto runtime override pathname is present")

    wmi: pathlib.Path | None = None
    core: pathlib.Path | None = None

    def heartbeat(status: str) -> None:
        notify(f"WATCHDOG=1\nSTATUS={status}")

    try:
        require_policy_identity()
        wmi = one_hwmon("msi_wmi_platform")
        core = one_hwmon("coretemp")
        recovery_latched = recovery_latch_present()
        existing_boost = read(BASE / "cooler_boost") == "on"
        initial_physical_verification = force_apply_default(
            wmi, existing_boost or recovery_latched, heartbeat)
        if recovery_latched:
            consume_recovery_latch()
        print(
            "Candidate14 applied; "
            f"preserved_boost={existing_boost or recovery_latched} "
            f"recovery_latch={recovery_latched}",
              file=sys.stderr, flush=True)
        safety = Safety()
        manual_boost = existing_boost and not recovery_latched
        automatic_boost = recovery_latched
        release_pending = False
        release_cool_since: float | None = None
        alarm = AlarmHold()
        sensor_hold = SensorHold()
        response: BoostResponse | None = None
        boost_ack_pending = False
        last_valid_monotonic_ns: int | None = None
        last_runtime_poll: float | None = None
        observed_monotonic_ns: int | None = None
        ready = False
        last_health_error: float | None = None

        def observe_response(sample: RuntimeSample | None, now: float) -> bool:
            nonlocal response
            if read(BASE / "cooler_boost") != "on":
                response = None
                return False
            if response is None:
                response = BoostResponse(now)
            return response.observe(
                sample.fan1 if sample else None,
                sample.fan2 if sample else None, now)

        def runtime_heartbeat(status: str, sample: RuntimeSample | None,
                              errors: dict[str, str], reason: str | None,
                              verified: bool, degraded: bool) -> None:
            nonlocal ready, last_health_error
            now = time.monotonic()
            since = release_cool_since if release_pending and manual_boost else safety.cool_since
            payload = {
                "schema": 1,
                "pid": os.getpid(),
                # Publication time is not observation time: the first channel
                # may already be old when a later sysfs read finally returns.
                "sampled_monotonic_ns": observed_monotonic_ns,
                "state": "degraded" if degraded else (
                    "cooling" if manual_boost or automatic_boost else "normal"),
                "reason": reason,
                "last_valid_monotonic_ns": last_valid_monotonic_ns,
                "manual_boost": manual_boost,
                "automatic_boost": automatic_boost,
                "release_pending": release_pending,
                "physical_response_verified": verified,
                "cooldown_elapsed_seconds": 0.0 if since is None else max(0.0, now - since),
                "telemetry": sample.as_health() if sample else None,
                "channel_errors": errors,
            }
            if timing is not None:
                payload["timing_metrics"] = timing.snapshot()
            try:
                publish_health(payload)
            except (OSError, ProfileError, ValueError) as error:
                # Loss of diagnostics must not stop otherwise working cooling.
                if last_health_error is None or now - last_health_error >= 60:
                    print(f"WARNING runtime health publication failed: {error}",
                          file=sys.stderr, flush=True)
                    last_health_error = now
            if not ready:
                notify(f"READY=1\nWATCHDOG=1\nSTATUS={status}")
                ready = True
            else:
                heartbeat(status)

        def complete_iteration(started: float) -> None:
            if timing is not None:
                timing.finish_loop()
            delay = POLL_INTERVAL_SECONDS - (time.monotonic() - started)
            if delay > 0:
                time.sleep(delay)
        if initial_physical_verification is False:
            sensor_hold.record(time.monotonic())
            if not manual_boost:
                automatic_boost = True
            print(
                "WARNING initial physical fan telemetry is invalid; "
                "Candidate14 remains active with Cooler Boost latched",
                file=sys.stderr, flush=True)
        last_suspend_offset = (time.clock_gettime(time.CLOCK_BOOTTIME) -
                               time.monotonic())
        last_log = 0.0

        while not STOP:
            started = time.monotonic()
            if timing is not None:
                timing.begin_loop()
            try:
                OVERRIDE.lstat()
            except FileNotFoundError:
                pass
            else:
                raise ProfileError("factory-auto runtime override pathname appeared")
            control = require_policy_identity(monitoring=True, timing=timing)
            # Legacy mocked/real policy checks return no combined acquisition.
            if not isinstance(control, MonitorControl):
                control = None
            suspend_offset = (time.clock_gettime(time.CLOCK_BOOTTIME) -
                              time.monotonic())
            if suspend_offset - last_suspend_offset > 2:
                preserve = manual_boost or automatic_boost or read(BASE / "cooler_boost") == "on"
                print("resume detected; forcing Candidate14 reapply", file=sys.stderr,
                      flush=True)
                reapply_physical_verification = force_apply_default(
                    wmi, preserve, heartbeat)
                response = None
                safety = Safety()
                release_cool_since = None
                alarm.clear()
                if reapply_physical_verification is False:
                    sensor_hold.record(time.monotonic())
                    if not manual_boost:
                        automatic_boost = True
                else:
                    sensor_hold.clear()
                # Resume/reapply invalidates previously acquired EC temperatures.
                control = require_policy_identity(monitoring=True, timing=timing)
                if not isinstance(control, MonitorControl):
                    control = None
            last_suspend_offset = suspend_offset

            curve = control.state.curve if control else read(BASE / "fan_curve")
            mode = control.state.mode if control else read(BASE / "fan_mode")
            boost = control.state.boost if control else read(BASE / "cooler_boost")
            if curve != DEFAULT or mode != "advanced" or boost not in ("on", "off"):
                if curve == FACTORY and mode == "auto" and boost in ("on", "off"):
                    preserve = manual_boost or automatic_boost or boost == "on"
                    reapply_physical_verification = force_apply_default(
                        wmi, preserve, heartbeat)
                    response = None
                    safety = Safety()
                    release_cool_since = None
                    alarm.clear()
                    if reapply_physical_verification is False:
                        sensor_hold.record(time.monotonic())
                        if not manual_boost:
                            automatic_boost = True
                    else:
                        sensor_hold.clear()
                    if control is not None:
                        control = require_policy_identity(monitoring=True, timing=timing)
                    boost = control.state.boost if control else read(BASE / "cooler_boost")
                else:
                    raise ProfileError(f"unexpected runtime state: {mode}/{boost}/{curve!r}")

            # Process requests even while a thermal channel is unavailable.
            # A new Boost-on cancels a previous release; its acknowledgement
            # waits for actual fan response, not merely the control bit.
            if BOOST_REQUEST:
                write(BASE / "cooler_boost", "on")
                manual_boost = True
                automatic_boost = False
                boost_ack_pending = True
                release_pending = False
                release_cool_since = None
                safety.cool_since = None
                alarm.clear()
                BOOST_REQUEST = False
                boost = "on"
            if RELEASE_REQUEST:
                if read(BASE / "cooler_boost") == "on":
                    release_pending = True
                    release_cool_since = None
                    acknowledge("boost-release-queued")
                    print("explicit Cooler Boost release queued", file=sys.stderr,
                          flush=True)
                else:
                    release_pending = False
                    release_cool_since = None
                    acknowledge("boost-release")
                RELEASE_REQUEST = False

            slow_acquisition = False
            try:
                sampled_at = control.acquisition_started if control else time.monotonic()
                if (last_runtime_poll is not None and
                        sampled_at - last_runtime_poll > MAX_OBSERVATION_GAP_SECONDS):
                    safety = Safety()
                    release_cool_since = None
                    alarm.clear()
                    response = None
                    sensor_hold.record(sampled_at)
                    if not manual_boost:
                        automatic_boost = True
                    if read(BASE / "cooler_boost") != "on":
                        write(BASE / "cooler_boost", "on")
                    print("WARNING monitoring gap; Boost latched and cooldown reset",
                          file=sys.stderr, flush=True)
                acquisition_started = (control.acquisition_started if control else
                                       time.monotonic())
                observed_monotonic_ns = int(acquisition_started * 1_000_000_000)
                last_runtime_poll = acquisition_started
                if timing is not None and control is None:
                    timing.begin_sensor(acquisition_started)
                sensor_error: SensorSampleError | None = None
                try:
                    if control is None:
                        sample = read_runtime_sample(core, wmi)
                    else:
                        sample = read_runtime_sample(
                            core, wmi, ec_temperatures=(control.state.ec_cpu,
                                                       control.state.ec_gpu))
                except SensorSampleError as error:
                    sample = error.partial
                    sensor_error = error
                acquisition_finished = time.monotonic()
                slow_acquisition = (acquisition_finished - acquisition_started >
                                    MAX_OBSERVATION_GAP_SECONDS)
                if timing is not None:
                    timing.finish_sensor(slow_acquisition)
                if slow_acquisition:
                    response = None
                    errors = dict(sensor_error.channel_errors) if sensor_error else {}
                    detail = ("slow sensor acquisition "
                              f"{acquisition_finished - acquisition_started:.3f}s "
                              f"exceeded {MAX_OBSERVATION_GAP_SECONDS:.0f}s observation budget")
                    errors["acquisition"] = detail
                    raise SensorSampleError(detail, sample, errors)
                if sensor_error is not None:
                    raise sensor_error
            except SensorSampleError as error:
                # A malformed EC/WMI sample must never convert an active
                # full-cooling state into an unattended service failure. Keep
                # the exact active profile, continuously reassert Boost, and
                # remain observable until both telemetry and physical RPM
                # verification recover.
                safety = Safety()
                release_cool_since = None
                alarm.clear()
                transition = sensor_hold.record(acquisition_finished)
                if read(BASE / "cooler_boost") != "on":
                    write(BASE / "cooler_boost", "on")
                if not manual_boost:
                    automatic_boost = True
                # Old RPM from a stalled acquisition is not fresh response
                # evidence, even when its numeric values are plausible.
                verified = (False if slow_acquisition else
                            observe_response(error.partial, acquisition_finished))
                if boost_ack_pending and verified:
                    acknowledge("boost-on")
                    boost_ack_pending = False
                if transition == "established":
                    print(
                        "WARNING sensor telemetry degraded; "
                        f"Candidate14 remains active with Cooler Boost requested: {error}",
                        file=sys.stderr, flush=True)
                elif transition == "ongoing":
                    print(
                        "WARNING sensor telemetry remains degraded; "
                        f"Candidate14 and Cooler Boost remain latched: {error}",
                        file=sys.stderr, flush=True)
                elapsed = sensor_hold.elapsed(acquisition_finished)
                runtime_heartbeat(
                    f"Sensor telemetry degraded {elapsed:.0f}s; Candidate14 active; "
                    f"Cooler Boost latched; fan response "
                    f"{'verified' if verified else 'unverified'}; {error}",
                    error.partial, error.channel_errors or {"sample": str(error)},
                    str(error), verified, True)
                complete_iteration(started)
                continue

            last_valid_monotonic_ns = observed_monotonic_ns
            cpu = sample.cpu
            ec_gpu = sample.ec_gpu
            fan1 = sample.fan1
            fan2 = sample.fan2
            reason = safety.update(cpu, ec_gpu, fan1, fan2, acquisition_started)
            if reason or automatic_boost or boost_ack_pending or sensor_hold.started is not None:
                if read(BASE / "cooler_boost") != "on":
                    write(BASE / "cooler_boost", "on")
                if reason and not manual_boost:
                    automatic_boost = True
            verified = observe_response(sample, acquisition_finished)
            if boost_ack_pending and verified:
                acknowledge("boost-on")
                boost_ack_pending = False
                print("explicit Cooler Boost enabled and fan response verified",
                      file=sys.stderr, flush=True)

            if sensor_hold.started is not None:
                # A complete sample alone is insufficient to leave degraded
                # mode: first prove that the commanded Boost still reaches both
                # physical fans. Invalid RPM telemetry keeps the latch active;
                # plausibly low RPM remains a genuine fan-response failure.
                if not verified:
                    transition = sensor_hold.record(time.monotonic())
                    if read(BASE / "cooler_boost") != "on":
                        write(BASE / "cooler_boost", "on")
                    if transition == "ongoing":
                        print(
                            "WARNING physical fan telemetry remains invalid; "
                            "Candidate14 and Cooler Boost remain latched; "
                            "fan response is unverified",
                            file=sys.stderr, flush=True)
                    elapsed = sensor_hold.elapsed(time.monotonic())
                    runtime_heartbeat(
                        f"Sensor telemetry degraded {elapsed:.0f}s; Candidate14 active; "
                        "Cooler Boost latched; fan response unverified",
                        sample, {}, "fan response unverified", False, True)
                    complete_iteration(started)
                    continue
                sensor_hold.clear()
                print(
                    "sensor telemetry recovered; Cooler Boost remains latched "
                    "until monitored cooldown completes",
                    file=sys.stderr, flush=True)

            boost = read(BASE / "cooler_boost")
            if reason:
                # Preserve a queued explicit release, but require a fresh full
                # cool interval after every unsafe observation.
                release_cool_since = None
                safety.cool_since = None
                if boost != "on":
                    write(BASE / "cooler_boost", "on")
                transition = alarm.record_verification(acquisition_finished) if verified else None
                if transition == "established":
                    print(f"Cooler Boost established for alarm: {reason}",
                          file=sys.stderr, flush=True)
                elif transition == "sustained":
                    print(
                        f"WARNING sustained safety alarm; remaining active with "
                        f"verified Cooler Boost: {reason}",
                        file=sys.stderr, flush=True)
                elif transition == "ongoing":
                    print(
                        f"WARNING sustained safety alarm continues with verified "
                        f"Cooler Boost: {reason}",
                        file=sys.stderr, flush=True)
                if not manual_boost:
                    automatic_boost = True
            else:
                if alarm.clear():
                    print(
                        "sustained safety alarm cleared; Cooler Boost remains "
                        "governed by its current latch/release policy",
                        file=sys.stderr, flush=True)
                timer_now = time.monotonic()
                if automatic_boost:
                    # External/keyboard off cannot defeat the automatic latch.
                    if boost != "on":
                        write(BASE / "cooler_boost", "on")
                    is_cool = cpu < 85000 and (ec_gpu == 0 or ec_gpu < 70)
                    safety.cool_since = Safety.update_since(
                        safety.cool_since, is_cool, timer_now)
                    if (verified and safety.cool_since is not None and
                            timer_now - safety.cool_since >= 30):
                        write(BASE / "cooler_boost", "off")
                        automatic_boost = False
                        if release_pending:
                            acknowledge("boost-release")
                        release_pending = False
                        release_cool_since = None
                        safety.cool_since = None
                        response = None
                        verified = False
                        print("automatic Cooler Boost released after 30-second cooldown",
                              file=sys.stderr, flush=True)
                else:
                    # Track keyboard toggles only when no automatic latch is active.
                    manual_boost = boost == "on"
                    if not manual_boost:
                        # An observed off transition fulfills/cancels any pending
                        # request for the previous manual Boost latch.
                        if release_pending:
                            acknowledge("boost-release")
                        release_pending = False
                        release_cool_since = None

                if release_pending and manual_boost:
                    is_cool = cpu < 85000 and (ec_gpu == 0 or ec_gpu < 70)
                    release_cool_since = Safety.update_since(
                        release_cool_since, is_cool, timer_now)
                    if (verified and release_cool_since is not None and
                            timer_now - release_cool_since >= 30):
                        write(BASE / "cooler_boost", "off")
                        manual_boost = False
                        release_pending = False
                        release_cool_since = None
                        response = None
                        verified = False
                        acknowledge("boost-release")
                        print("explicit Cooler Boost released after 30-second cooldown",
                              file=sys.stderr, flush=True)

            if started - last_log >= 60:
                alarm_note = f" sustained_alarm={reason!r}" if alarm.sustained else ""
                print(f"status cpu={cpu//1000}C gpu={ec_gpu}C fans={fan1}/{fan2} "
                      f"boost={read(BASE/'cooler_boost')}{alarm_note}", file=sys.stderr,
                      flush=True)
                last_log = started
            if alarm.sustained and verified:
                runtime_heartbeat(
                    f"Sustained safety alarm: {reason}; Cooler Boost verified; "
                    f"CPU {cpu//1000}C GPU {ec_gpu}C fans {fan1}/{fan2}",
                    sample, {}, reason, verified, False)
            else:
                runtime_heartbeat(
                    f"Candidate14 CPU {cpu//1000}C GPU {ec_gpu}C fans {fan1}/{fan2}; "
                    f"fan response {'verified' if verified else 'unverified'}",
                    sample, {}, reason, verified, False)
            complete_iteration(started)

        print("clean stop requested; restoring factory auto", file=sys.stderr,
              flush=True)
        heartbeat("Restoring factory auto")
        if not restore_factory_envelope():
            raise ProfileError("factory restoration failed")
        if not release_factory_if_cool(core):
            raise ProfileError("factory restored; Boost release unsafe")
        notify("STOPPING=1\nSTATUS=Factory auto/off restored")
        return 0
    finally:
        # Runtime faults deliberately do not write the factory curve here.
        # systemd invokes the independent root-owned ExecStopPost helper after
        # this process exits, so it can establish one verified full-cooling
        # postcondition without concurrent daemon writes. Keep the descriptor
        # open until this function finishes so that helper serializes after us.
        pass


def entrypoint() -> int:
    signal.signal(signal.SIGTERM, on_stop)
    signal.signal(signal.SIGINT, on_stop)
    signal.signal(signal.SIGHUP, on_stop)
    signal.signal(signal.SIGUSR1, on_boost)
    signal.signal(signal.SIGUSR2, on_release)
    try:
        return main()
    except Exception as error:
        print(f"ERROR {type(error).__name__}: {error}", file=sys.stderr,
              flush=True)
        return 1


if __name__ == "__main__":
    raise SystemExit(entrypoint())

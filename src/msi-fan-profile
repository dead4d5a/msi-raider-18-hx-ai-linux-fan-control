def identity():
 e={pathlib.Path('/sys/class/dmi/id/product_name'):'Raider 18 HX AI A2XWIG',pathlib.Path('/sys/class/dmi/id/board_name'):'MS-1824',pathlib.Path('/sys/class/dmi/id/bios_version'):'E1824IMS.310',pathlib.Path('/sys/module/msi_ec/version'):'0.13.1',pathlib.Path('/sys/module/msi_ec/srcversion'):'AB0BFAE2391B5ADD66E01BD',BASE/'fw_version':'1824EMS1.108'}

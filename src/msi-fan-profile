FACTORY='58 64 70 76 82 88 0 25 35 44 58 70 75 52 58 64 70 76 82 0 25 35 44 58 70 75'
DEFAULT='50 60 70 76 82 88 20 30 40 50 60 80 110 38 40 42 44 55 70 20 30 40 60 70 100 120'
COMMANDS=('status','apply-default','factory-auto','boost-on','boost-release')
class ManagerError(RuntimeError):pass

def read(p):
 with pathlib.Path(p).open('r',encoding='ascii') as f:return f.read().strip()
def run(*a,check=True,timeout=45):return subprocess.run(a,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,timeout=timeout,check=check,env={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','LC_ALL':'C'})

def enabled():return enable_state()=='enabled'
def active():return ctl('is-active','--quiet',SERVICE,check=False,timeout=8).returncode==0
def hw():
 c=read(BASE/'fan_curve');return {'curve':'candidate14' if c==DEFAULT else 'factory' if c==FACTORY else 'unknown','raw':c,'mode':read(BASE/'fan_mode'),'boost':read(BASE/'cooler_boost')}
def restore_factory_locked(release=True):
 for p,v in ((BASE/'cooler_boost','on'),(BASE/'fan_mode','auto'),(BASE/'fan_curve',FACTORY),(BASE/'cooler_boost','on')):write(p,v)
 h=hw()
 if h['raw']!=FACTORY or h['mode']!='auto' or h['boost']!='on':raise ManagerError('factory envelope verification failed')
 if release:
  core=[p for p in pathlib.Path('/sys/class/hwmon').glob('hwmon*') if (p/'name').exists() and read(p/'name')=='coretemp']
  if len(core)!=1:raise ManagerError('coretemp discovery failed')
  pkg=int(read(core[0]/'temp1_input'));cpu=int(read(BASE/'cpu/realtime_temperature'));gpu=int(read(BASE/'gpu/realtime_temperature'))
  if max(pkg,cpu*1000)>=85000 or not (gpu==0 or gpu<70):raise ManagerError('factory restored but too hot to release Boost')
  write(BASE/'fan_mode','auto');write(BASE/'cooler_boost','off')
  h=hw()
  if h['raw']!=FACTORY or h['mode']!='auto' or h['boost']!='off':write(BASE/'cooler_boost','on');raise ManagerError('factory auto/off verification failed')
def disable_and_safe_factory():
 marker_error=None
 try:make_marker()
 except Exception as e:marker_error=e
 stop_keeper()
 ctl('disable',SERVICE,check=False,timeout=20);ctl('stop',SERVICE,check=False,timeout=45);ctl('reset-failed',SERVICE,check=False,timeout=10)
 if not inactive_dead():raise ManagerError('service not inactive/dead during fail-safe')
 if enabled():raise ManagerError('service remained persistently enabled during fail-safe')
 fd=lock(FAN_LOCK)
 try:restore_factory_locked(release=False)
 finally:os.close(fd)
 if marker_error is not None:raise ManagerError(f'unsafe override marker prevented verified boot block: {marker_error}')
def full_status():
 identity();s=unit_state();k=unit_state(KEEPER);h=hw();return {'service_enabled':enabled(),'service_active_state':s['ActiveState'],'service_sub_state':s['SubState'],'service_main_pid':int(s['MainPID'] or 0),'service_job':s['Job'],'keeper_active_state':k['ActiveState'],'keeper_sub_state':k['SubState'],'keeper_main_pid':int(k['MainPID'] or 0),'keeper_job':k['Job'],'factory_override':marker(),'recovery_boost_latched':recovery_latch(),'curve':h['curve'],'fan_mode':h['mode'],'cooler_boost':h['boost'],'shift_mode':read(BASE/'shift_mode'),'ec_firmware':read(BASE/'fw_version'),'driver_version':read('/sys/module/msi_ec/version'),'driver_srcversion':read('/sys/module/msi_ec/srcversion')}
def status():
 first=full_status();time.sleep(.05);second=full_status();stable=first==second;second['snapshot_stable']=stable;print(json.dumps(second,indent=2,sort_keys=True));s=second;keeper_inactive=s['keeper_active_state']=='inactive' and s['keeper_sub_state']=='dead' and s['keeper_main_pid']==0 and not s['keeper_job'];default=stable and s['service_enabled'] and s['service_active_state']=='active' and s['service_sub_state']=='running' and s['service_main_pid']>0 and not s['service_job'] and keeper_inactive and not s['factory_override'] and not s['recovery_boost_latched'] and s['curve']=='candidate14' and s['fan_mode']=='advanced' and s['cooler_boost'] in ('on','off');override=stable and s['service_enabled'] and s['service_active_state']=='inactive' and s['service_sub_state']=='dead' and s['service_main_pid']==0 and not s['service_job'] and keeper_inactive and s['factory_override'] and not s['recovery_boost_latched'] and s['curve']=='factory' and s['fan_mode']=='auto' and s['cooler_boost']=='off';return 0 if default or override else 1
def root():
 if os.geteuid():raise ManagerError('root required; use sudo')
def apply_default():
 root();identity();fd=lock(MANAGER_LOCK);start_attempted=False
 try:
  if marker():OVERRIDE.unlink()
  stop_keeper();ctl('reset-failed',SERVICE,check=False,timeout=10);ctl('enable',SERVICE,timeout=20);start_attempted=True;ctl('start',SERVICE,timeout=50)
  s=full_status()
  ok=s['service_enabled'] and s['service_active_state']=='active' and s['service_sub_state']=='running' and s['service_main_pid']>0 and not s['service_job'] and s['keeper_active_state']=='inactive' and s['keeper_sub_state']=='dead' and s['keeper_main_pid']==0 and not s['keeper_job'] and not s['factory_override'] and not s['recovery_boost_latched'] and s['curve']=='candidate14' and s['fan_mode']=='advanced'
  if not ok:raise ManagerError('default invariant failed')
  print('Candidate14 is active and enabled for future boots.')
 except Exception as e:
  if start_attempted:raise ManagerError(f'apply-default activation failed after start was attempted: {e}; left service state and runtime full-cooling recovery untouched') from e
  try:disable_and_safe_factory()
  except Exception as r:raise ManagerError(f'apply-default failed: {e}; fail-safe failed: {r}') from e
  raise ManagerError(f'apply-default failed: {e}; service disabled, factory auto with Boost on') from e
 finally:os.close(fd)
def factory_auto():
 root();identity();fd=lock(MANAGER_LOCK)
 try:
  make_marker();stop_keeper();ctl('stop',SERVICE,check=False,timeout=50);ctl('reset-failed',SERVICE,check=False,timeout=10)
  if not inactive_dead():raise ManagerError('service did not become inactive/dead')
  fan=lock(FAN_LOCK)
  try:
   restore_factory_locked(release=True);clear_recovery_latch()
  finally:os.close(fan)
  s=full_status();ok=s['service_enabled'] and s['service_active_state']=='inactive' and s['service_sub_state']=='dead' and s['service_main_pid']==0 and not s['service_job'] and s['keeper_active_state']=='inactive' and s['keeper_sub_state']=='dead' and s['keeper_main_pid']==0 and not s['keeper_job'] and s['factory_override'] and not s['recovery_boost_latched'] and s['curve']=='factory' and s['fan_mode']=='auto' and s['cooler_boost']=='off'
  if not ok:raise ManagerError('factory override invariant failed')
  print('Factory auto/off is active until apply-default or reboot.')
 except Exception as e:
  try:disable_and_safe_factory()
  except Exception as r:raise ManagerError(f'factory-auto failed: {e}; fail-safe failed: {r}') from e
  raise ManagerError(f'factory-auto failed: {e}; service disabled, factory auto with Boost on') from e
 finally:os.close(fd)
def ack(action,pid,after):
 if not ACK.exists():return False
 i=ACK.lstat()
 if not stat.S_ISREG(i.st_mode) or i.st_uid or i.st_gid or stat.S_IMODE(i.st_mode)!=0o600:raise ManagerError('unsafe ack file')
 parts=dict(x.split('=',1) for x in read(ACK).split())
 return parts.get('pid')==str(pid) and parts.get('action')==action and int(parts.get('monotonic_ns','0'))>=after
def signal_action(action,sig,timeout_s):
 root();identity();fd=lock(MANAGER_LOCK)
 try:
  s=full_status()
  if not(s['service_enabled'] and s['service_active_state']=='active' and s['service_sub_state']=='running' and s['service_main_pid']>0 and s['keeper_active_state']=='inactive' and s['keeper_sub_state']=='dead' and s['keeper_main_pid']==0 and not s['keeper_job'] and not s['factory_override'] and s['curve']=='candidate14' and s['fan_mode']=='advanced'):raise ManagerError('active default invariant missing')
  if action=='boost-release' and s['cooler_boost']=='off':print('Cooler Boost is already off.');return
  before=time.monotonic_ns();ctl('kill','--kill-whom=main',f'--signal={sig.name}',SERVICE,timeout=10);deadline=None if timeout_s is None else time.monotonic()+timeout_s
  while deadline is None or time.monotonic()<deadline:
   if not active():raise ManagerError('service failed while processing request')
   h=hw()
   if ack(action,s['service_main_pid'],before):
    if action=='boost-on' and h['boost']=='on':print('Cooler Boost enabled and physically verified.');return
    if action=='boost-release' and h['boost']=='off':print('Cooler Boost released after monitored cooldown.');return
   time.sleep(.25)
  raise ManagerError(f'{action} was not acknowledged before timeout')
 finally:os.close(fd)
def main():
 if len(sys.argv)!=2 or sys.argv[1] not in COMMANDS:print('Usage: msi-fan-profile {status|apply-default|factory-auto|boost-on|boost-release}',file=sys.stderr);return 2
 c=sys.argv[1]
 if c=='status':return status()
 if c=='apply-default':apply_default()
 elif c=='factory-auto':factory_auto()
 elif c=='boost-on':signal_action(c,signal.SIGUSR1,25)
 elif c=='boost-release':signal_action(c,signal.SIGUSR2,None)

def marker():
 try:i=OVERRIDE.lstat()
 except FileNotFoundError:return False
 if not stat.S_ISREG(i.st_mode) or i.st_uid or i.st_gid or stat.S_IMODE(i.st_mode)!=0o600:raise ManagerError('unsafe override marker')

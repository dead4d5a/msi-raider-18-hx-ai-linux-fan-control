def clear_recovery_latch():
 if not recovery_latch():return
 RECOVERY_LATCH.unlink()
 if recovery_latch():raise ManagerError('recovery Boost latch remained after factory handoff')
def unit_state(service=SERVICE):
 vals={k:ctl('show',service,f'-p{k}','--value',timeout=8).stdout.strip() for k in ('ActiveState','SubState','MainPID','Job')}
 return vals
def inactive_dead(service=SERVICE):
 s=unit_state(service);return s['ActiveState']=='inactive' and s['SubState']=='dead' and s['MainPID']=='0' and not s['Job']
def stop_keeper():
 ctl('stop',KEEPER,check=False,timeout=50);ctl('reset-failed',KEEPER,check=False,timeout=10)
 if not inactive_dead(KEEPER):raise ManagerError('recovery keeper did not become inactive/dead')
def enable_state():
 r=ctl('is-enabled',SERVICE,check=False,timeout=8);state=r.stdout.strip()
 if state not in ('enabled','disabled'):raise ManagerError(f'unknown service enable state: {state!r} rc={r.returncode}')

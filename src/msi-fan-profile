"""Exact-command manager for the persistent MSI Candidate14 fan profile."""
from __future__ import annotations

import fcntl,json,os,pathlib,signal,stat,subprocess,sys,time

BASE=pathlib.Path('/sys/devices/platform/msi-ec');SERVICE='msi-fan-profile.service';KEEPER='msi-fan-profile-keeper.service'
OVERRIDE=pathlib.Path('/run/msi-fan-profile.factory-auto');ACK=pathlib.Path('/run/msi-fan-profile.ack');RECOVERY_LATCH=pathlib.Path('/run/msi-fan-profile.recovery-boost');RECOVERY_LATCH_PAYLOAD=b'candidate14\n'

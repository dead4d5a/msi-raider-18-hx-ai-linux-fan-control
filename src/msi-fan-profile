 if not marker():raise ManagerError('marker verification failed')
def recovery_latch():
 try:i=RECOVERY_LATCH.lstat()
 except FileNotFoundError:return False
 if not stat.S_ISREG(i.st_mode) or i.st_uid or i.st_gid or stat.S_IMODE(i.st_mode)!=0o600 or i.st_nlink!=1:raise ManagerError('unsafe recovery Boost latch')
 fd=os.open(RECOVERY_LATCH,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC)
 try:
  p=os.fstat(fd)
  if (p.st_dev,p.st_ino)!=(i.st_dev,i.st_ino) or not stat.S_ISREG(p.st_mode) or p.st_uid or p.st_gid or stat.S_IMODE(p.st_mode)!=0o600 or p.st_nlink!=1:raise ManagerError('recovery Boost latch changed during validation')
  payload=os.read(fd,len(RECOVERY_LATCH_PAYLOAD)+1)
 finally:os.close(fd)
 if payload!=RECOVERY_LATCH_PAYLOAD:raise ManagerError('invalid recovery Boost latch payload')

[Unit]
Description=MSI Raider Candidate14 failed-controller full-cooling keeper
Documentation=file:/usr/local/share/doc/msi-fan-profile/README.md
RequiresMountsFor=/usr/local /usr
ConditionPathExists=/sys/devices/platform/msi-ec/fan_curve
ConditionPathExists=!/run/msi-fan-profile.factory-auto
Conflicts=msi-fan-profile.service
Before=msi-fan-profile.service
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
Environment=MSI_CALIBRATION_PROFILE=candidate14
ExecStart=/usr/local/libexec/msi-gpu-recover --keeper candidate14
WatchdogSec=5s
WatchdogSignal=SIGKILL
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
MemoryMax=64M
TasksMax=16
UMask=0077

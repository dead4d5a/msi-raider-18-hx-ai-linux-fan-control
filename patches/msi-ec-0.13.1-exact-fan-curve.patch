+#define FAN_CURVE_TEMP_POINTS	6
+#define FAN_CURVE_SPEED_POINTS	7
+#define FAN_CURVE_CPU_TEMP_ADDR	0x6a
+#define FAN_CURVE_CPU_SPEED_ADDR	0x72

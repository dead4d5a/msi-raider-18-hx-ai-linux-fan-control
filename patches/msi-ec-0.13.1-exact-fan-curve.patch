 #define SM_COMFORT_NAME		"comfort"
@@ -1853,6 +1868,7 @@ static struct msi_ec_conf *CONFIGURATIONS[] __initdata = {
 
 static bool conf_loaded = false;
 static struct msi_ec_conf conf; // current configuration
+static bool fan_curve_supported;
 
 static bool charge_control_supported = false;
 
@@ -2147,6 +2163,383 @@ static struct acpi_battery_hook battery_hook = {
 	.name = MSI_EC_DRIVER_NAME,

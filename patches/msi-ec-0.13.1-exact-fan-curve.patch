+/*
+ * Local, exact-platform fan-curve interface.
+ *
+ * The EC stores 6 temperature thresholds and 7 speed points per fan.  The
+ * whole 26-byte curve is exposed as one transaction in this order:
+ *
+ *   cpu_temp[6] cpu_speed[7] gpu_temp[6] gpu_speed[7]
+ *
+ * Writes are intentionally restricted to the one platform and EC revision on
+ * which these addresses were measured.  The curve is inactive while fan mode
+ * is automatic.  The driver establishes automatic mode plus Cooler Boost for
+ * the transaction and leaves that safe envelope active on return.  A failed
+ * write or readback attempts and verifies restoration of the complete
+ * pre-write curve.
+ */
+static const u8 fan_curve_factory[FAN_CURVE_TOTAL_VALUES] = {
+	58, 64, 70, 76, 82, 88,
+	0, 25, 35, 44, 58, 70, 75,
+	52, 58, 64, 70, 76, 82,
+	0, 25, 35, 44, 58, 70, 75,
+};
+
+static bool fan_curve_exact_platform(void)
+{
+	return dmi_match(DMI_PRODUCT_NAME, "Raider 18 HX AI A2XWIG") &&
+	       dmi_match(DMI_BOARD_NAME, "MS-1824") &&
+	       dmi_match(DMI_BIOS_VERSION, "E1824IMS.310");
+}
+
+static int fan_curve_check_firmware(void)
+{
+	u8 version[MSI_EC_FW_VERSION_LENGTH + 1];
+	int result;
+
+	if (!fan_curve_exact_platform())
+		return -EOPNOTSUPP;
+
+	result = ec_get_firmware_version(version);
+	if (result < 0)
+		return result;
+
+	return strcmp(version, "1824EMS1.108") ? -EOPNOTSUPP : 0;
+}
+
+static bool fan_curve_configuration_matches(void)
+{
+	return conf.fan_mode.address == FAN_CURVE_MODE_ADDR &&
+	       conf.cooler_boost.address == FAN_CURVE_BOOST_ADDR &&
+	       conf.cooler_boost.bit == FAN_CURVE_BOOST_BIT;
+}
+
+static int fan_curve_read_values(u8 values[FAN_CURVE_TOTAL_VALUES])
+{
+	int result;
+
+	result = ec_read_seq(FAN_CURVE_CPU_TEMP_ADDR, values,
+			     FAN_CURVE_TEMP_POINTS);
+	if (result < 0)
+		return result;
+
+	result = ec_read_seq(FAN_CURVE_CPU_SPEED_ADDR,
+			     values + FAN_CURVE_TEMP_POINTS,
+			     FAN_CURVE_SPEED_POINTS);
+	if (result < 0)
+		return result;
+
+	result = ec_read_seq(FAN_CURVE_GPU_TEMP_ADDR,
+			     values + FAN_CURVE_TEMP_POINTS +
+			     FAN_CURVE_SPEED_POINTS,
+			     FAN_CURVE_TEMP_POINTS);
+	if (result < 0)
+		return result;
+
+	return ec_read_seq(FAN_CURVE_GPU_SPEED_ADDR,
+			   values + 2 * FAN_CURVE_TEMP_POINTS +
+			   FAN_CURVE_SPEED_POINTS,
+			   FAN_CURVE_SPEED_POINTS);
+}
+
+static int fan_curve_write_region(u8 address, const u8 *values, size_t length)
+{
+	int result;
+
+	for (size_t i = 0; i < length; i++) {
+		result = ec_write(address + i, values[i]);
+		if (result < 0)
+			return result;
+	}
+
+	return 0;
+}
+
+static int fan_curve_write_region_best_effort(u8 address, const u8 *values,
+					      size_t length)
+{
+	int first_error = 0;
+	int result;
+
+	for (size_t i = 0; i < length; i++) {
+		result = ec_write(address + i, values[i]);
+		if (result < 0 && !first_error)
+			first_error = result;
+	}
+
+	return first_error;
+}
+
+static int fan_curve_write_values(const u8 values[FAN_CURVE_TOTAL_VALUES])
+{
+	int result;
+
+	result = fan_curve_write_region(FAN_CURVE_CPU_TEMP_ADDR, values,
+					FAN_CURVE_TEMP_POINTS);
+	if (result < 0)
+		return result;
+
+	result = fan_curve_write_region(FAN_CURVE_CPU_SPEED_ADDR,
+					values + FAN_CURVE_TEMP_POINTS,
+					FAN_CURVE_SPEED_POINTS);
+	if (result < 0)
+		return result;
+
+	result = fan_curve_write_region(FAN_CURVE_GPU_TEMP_ADDR,
+					values + FAN_CURVE_TEMP_POINTS +
+					FAN_CURVE_SPEED_POINTS,
+					FAN_CURVE_TEMP_POINTS);
+	if (result < 0)
+		return result;
+
+	return fan_curve_write_region(FAN_CURVE_GPU_SPEED_ADDR,
+				      values + 2 * FAN_CURVE_TEMP_POINTS +
+				      FAN_CURVE_SPEED_POINTS,
+				      FAN_CURVE_SPEED_POINTS);
+}
+
+static int fan_curve_restore_values(const u8 values[FAN_CURVE_TOTAL_VALUES])
+{
+	int first_error = 0;
+	int result;
+
+	result = fan_curve_write_region_best_effort(FAN_CURVE_CPU_TEMP_ADDR,
+						    values,
+						    FAN_CURVE_TEMP_POINTS);
+	if (result < 0 && !first_error)
+		first_error = result;
+
+	result = fan_curve_write_region_best_effort(FAN_CURVE_CPU_SPEED_ADDR,
+						    values + FAN_CURVE_TEMP_POINTS,
+						    FAN_CURVE_SPEED_POINTS);
+	if (result < 0 && !first_error)
+		first_error = result;
+
+	result = fan_curve_write_region_best_effort(FAN_CURVE_GPU_TEMP_ADDR,
+						    values + FAN_CURVE_TEMP_POINTS +
+						    FAN_CURVE_SPEED_POINTS,
+						    FAN_CURVE_TEMP_POINTS);
+	if (result < 0 && !first_error)
+		first_error = result;
+
+	result = fan_curve_write_region_best_effort(FAN_CURVE_GPU_SPEED_ADDR,
+						    values + 2 * FAN_CURVE_TEMP_POINTS +
+						    FAN_CURVE_SPEED_POINTS,
+						    FAN_CURVE_SPEED_POINTS);
+	if (result < 0 && !first_error)
+		first_error = result;
+
+	return first_error;
+}
+
+static int fan_curve_establish_safe_state(void)
+{
+	int result;
+	u8 mode;
+	bool boost;
+
+	result = ec_set_bit(FAN_CURVE_BOOST_ADDR, FAN_CURVE_BOOST_BIT, true);
+	if (result < 0)
+		return result;
+
+	result = ec_write(FAN_CURVE_MODE_ADDR, FAN_CURVE_AUTO_MODE);
+	if (result < 0)
+		return result;
+
+	result = ec_read(FAN_CURVE_MODE_ADDR, &mode);
+	if (result < 0)
+		return result;
+	result = ec_check_bit(FAN_CURVE_BOOST_ADDR, FAN_CURVE_BOOST_BIT, &boost);
+	if (result < 0)
+		return result;
+
+	return mode == FAN_CURVE_AUTO_MODE && boost ? 0 : -EIO;
+}
+
+static bool fan_curve_monotonic(const u8 *values, size_t length, bool strict)
+{
+	for (size_t i = 1; i < length; i++) {
+		if (strict ? values[i] <= values[i - 1] :
+			     values[i] < values[i - 1])
+			return false;
+	}
+
+	return true;
+}
+
+static bool fan_curve_values_safe(const u8 values[FAN_CURVE_TOTAL_VALUES])
+{
+	const u8 *cpu_temp = values;
+	const u8 *cpu_speed = values + FAN_CURVE_TEMP_POINTS;
+	const u8 *gpu_temp = cpu_speed + FAN_CURVE_SPEED_POINTS;
+	const u8 *gpu_speed = gpu_temp + FAN_CURVE_TEMP_POINTS;
+
+	/* The exact captured factory curve must always remain restorable. */
+	if (!memcmp(values, fan_curve_factory, sizeof(fan_curve_factory)))
+		return true;
+
+	if (!fan_curve_monotonic(cpu_temp, FAN_CURVE_TEMP_POINTS, true) ||
+	    !fan_curve_monotonic(gpu_temp, FAN_CURVE_TEMP_POINTS, true) ||
+	    !fan_curve_monotonic(cpu_speed, FAN_CURVE_SPEED_POINTS, false) ||
+	    !fan_curve_monotonic(gpu_speed, FAN_CURVE_SPEED_POINTS, false))
+		return false;
+
+	if (cpu_temp[0] < 40 || cpu_temp[5] > 90 ||
+	    cpu_temp[4] > 85 || gpu_temp[0] < 35 ||
+	    gpu_temp[5] > 85 || gpu_temp[4] > 80)
+		return false;
+
+	for (size_t i = 0; i < FAN_CURVE_SPEED_POINTS; i++) {
+		if (cpu_speed[i] > 150 || gpu_speed[i] > 150)
+			return false;
+	}
+
+	if (cpu_speed[0] > 40 || gpu_speed[0] > 40 ||
+	    cpu_speed[4] < 60 || gpu_speed[4] < 60 ||
+	    cpu_speed[5] < 80 || gpu_speed[5] < 80 ||
+	    cpu_speed[6] < 100 || gpu_speed[6] < 100)
+		return false;
+
+	return true;
+}
+
+static ssize_t fan_curve_show(struct device *device,
+			      struct device_attribute *attr, char *buf)
+{
+	u8 values[FAN_CURVE_TOTAL_VALUES];
+	int count = 0;
+	int result;
+
+	result = fan_curve_check_firmware();
+	if (result < 0 || !fan_curve_supported)
+		return result < 0 ? result : -EOPNOTSUPP;
+
+	mutex_lock(&fan_curve_mutex);
+	result = fan_curve_read_values(values);
+	mutex_unlock(&fan_curve_mutex);
+	if (result < 0)
+		return result;
+
+	for (size_t i = 0; i < ARRAY_SIZE(values); i++)
+		count += sysfs_emit_at(buf, count, "%u%c", values[i],
+				       i + 1 == ARRAY_SIZE(values) ? '\n' : ' ');
+
+	return count;
+}
+
+static int fan_curve_parse(const char *buf,
+			   u8 requested[FAN_CURVE_TOTAL_VALUES])
+{
+	char *copy;
+	char *cursor;
+	char *token;
+	int result = 0;
+	size_t i = 0;
+
+	copy = kstrdup(buf, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+
+	cursor = strim(copy);
+	while ((token = strsep(&cursor, " \t\n")) != NULL) {
+		if (!*token)
+			continue;
+		if (i == FAN_CURVE_TOTAL_VALUES) {
+			result = -EINVAL;
+			goto free;
+		}
+		result = kstrtou8(token, 10, &requested[i]);
+		if (result < 0)
+			goto free;
+		i++;
+	}
+
+	if (i != FAN_CURVE_TOTAL_VALUES)
+		result = -EINVAL;
+
+free:
+	kfree(copy);
+	return result;
+}
+
+static ssize_t fan_curve_store(struct device *device,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	u8 requested[FAN_CURVE_TOTAL_VALUES];
+	u8 original[FAN_CURVE_TOTAL_VALUES];
+	u8 verify[FAN_CURVE_TOTAL_VALUES];
+	int result;
+	int cause;
+	int safe_result;
+	int rollback_result;
+	int verify_result;
+
+	result = fan_curve_parse(buf, requested);
+	if (result < 0)
+		return result;
+
+	if (!fan_curve_values_safe(requested))
+		return -EINVAL;
+
+	result = fan_curve_check_firmware();
+	if (result < 0 || !fan_curve_supported)
+		return result < 0 ? result : -EOPNOTSUPP;
+
+	mutex_lock(&fan_curve_mutex);
+
+	result = fan_curve_establish_safe_state();
+	if (result < 0)
+		goto unlock;
+
+	result = fan_curve_read_values(original);
+	if (result < 0)
+		goto unlock;
+
+	/* Revalidate the safe envelope immediately before the first curve write. */
+	result = fan_curve_establish_safe_state();
+	if (result < 0)
+		goto unlock;
+
+	result = fan_curve_write_values(requested);
+	if (result < 0)
+		goto rollback;
+
+	result = fan_curve_read_values(verify);
+	if (result < 0)
+		goto rollback;
+	if (memcmp(requested, verify, sizeof(requested))) {
+		result = -EIO;
+		goto rollback;
+	}
+
+	result = fan_curve_establish_safe_state();
+	if (result < 0)
+		goto rollback;
+
+	mutex_unlock(&fan_curve_mutex);
+	return count;
+
+rollback:
+	cause = result;
+	safe_result = fan_curve_establish_safe_state();
+	rollback_result = fan_curve_restore_values(original);
+	verify_result = fan_curve_read_values(verify);
+
+	if (safe_result < 0 || rollback_result < 0 || verify_result < 0 ||
+	    memcmp(original, verify, sizeof(original))) {
+		pr_err("fan curve rollback could not be verified\n");
+		result = -EIO;
+	} else {
+		pr_warn("fan curve update failed; original curve restored\n");
+		result = cause;
+	}
+
+unlock:
+	mutex_unlock(&fan_curve_mutex);
+	return result;
+}
+
